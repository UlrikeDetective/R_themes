add_osm_feature(key = "admin_level", value = "9") %>%
osmdata_sf()
# Extract multipolygons, safely filter using single/double quotes, and select 'name'
districts <- districts_raw$osm_multipolygons %>%
filter(name.prefix == "dzielnica") %>%
select(name)
library(sf)
library(osmdata)
library(dplyr)
city <- "Warsaw, Poland"
# ==========================================
# 1. DISTRICTS LAYER
# ==========================================
# 1. Fetch the data
districts_raw <- opq(bbox = city) %>%
add_osm_feature(key = "admin_level", value = "9") %>%
osmdata_sf()
# 2. Extract and filter without depending on 'name.prefix'
districts <- districts_raw$osm_multipolygons %>%
# Filter to ensure the feature has a valid name and isn't empty
filter(!is.na(name)) %>%
# Select just the name and spatial geometry column
select(name)
# Ensure geometry is clean and plot
districts <- st_make_valid(districts)
plot(st_geometry(districts), main = "Warsaw Districts")
# Save layer (creates data directory if missing)
if(!dir.exists("data")) dir.create("data")
write_sf(districts, "data/districts.gpkg")
# ==========================================
# 2. PARKS LAYER
# ==========================================
# Fix the missing pipe operator after the bounding box definition
parks_raw <- opq(bbox = city) %>%
add_osm_feature(key = "leisure", value = "park") %>%
osmdata_sf()
